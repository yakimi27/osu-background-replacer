<Page
    x:Class="OsuBackgroundReplacerMain.Views.ActivityLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OsuBackgroundReplacerMain.Models"
    mc:Ignorable="d">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Activity Log" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Review history and file locations of replaced osu! beatmap backgrounds."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Actions Toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox"
                                QueryIcon="Find"
                                PlaceholderText="Filter beatmaps..."
                                Width="220"
                                TextChanged="SearchBox_TextChanged" />

                <Button x:Name="ExportButton" Click="Export_Click" ToolTipService.ToolTip="Export log to a text file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>

                <Button x:Name="ClearButton" Click="Clear_Click" ToolTipService.ToolTip="Clear activity log">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="TotalReplacedTextBlock"
                                   Text="0 backgrounds replaced"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="LastRunTextBlock"
                                   Text="No operations yet"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <InfoBar x:Name="LogNotificationInfoBar"
                         Grid.Column="1"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />
            </Grid>
        </Border>

        <!-- Empty State Container -->
        <StackPanel x:Name="EmptyStateContainer"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <Border Width="64" Height="64" CornerRadius="32"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE81C;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <TextBlock Text="No Activity Recorded"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Replaced beatmaps will appear here once you run a replacement operation."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Items List -->
        <ListView x:Name="LogListView"
                  Grid.Row="2"
                  SelectionMode="None"
                  Padding="0,0,0,16">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LogEntry">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Status Icon -->
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Border>

                            <!-- Folder & File Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind FolderName}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FilePath}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Timestamp -->
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind FormattedTime}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0" />

                            <!-- Open Folder Button -->
                            <Button Grid.Column="3"
                                    Tag="{x:Bind FilePath}"
                                    Click="OpenItemFolder_Click"
                                    ToolTipService.ToolTip="Open folder in File Explorer"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
